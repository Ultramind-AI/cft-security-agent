# Never commit real API keys. Put them in your local .env only.
GROQ_API_KEY=
ZAI_API_KEY=
MISTRAL_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
NVIDIA_NIM_API_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Agent mode. Keep stub for deterministic tests; use llm for live demo.
CFT_AGENT_MODE=stub

# Optional comma-separated provider:model override. When empty, the built-in
# provider-diverse fallback chain is used.
CFT_LLM_ROUTES=
CFT_LLM_TIMEOUT_SECONDS=25
CFT_LLM_MAX_OUTPUT_TOKENS=1200
CFT_LLM_TRACE=false
