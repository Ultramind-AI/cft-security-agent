CFT_ENV=local
CFT_POLICY_FILE=policies/default.yaml
CFT_TARGET_FILE=targets/sberlab.yaml
CFT_MAX_ITERATIONS=5
CFT_TARGET_BASE_URL=http://127.0.0.1:8000
CFT_EXECUTOR_TIMEOUT_SECONDS=5
CFT_EXECUTOR_CPU_TIME_SECONDS=2
CFT_EXECUTOR_MEMORY_MB=256
CFT_EXECUTOR_MAX_FILE_BYTES=1048576
CFT_EXECUTOR_MAX_PROCESSES=8
CFT_EXECUTOR_MAX_OUTPUT_BYTES=16384
CFT_EXECUTOR_MAX_RUNS_PER_ACTION=1
CFT_EXECUTOR_MAX_CONCURRENT_RUNS=1
CFT_EXECUTOR_WORK_DIR=executor_data/workspaces
CFT_EVIDENCE_DIR=executor_data/evidence
CFT_EXECUTOR_AUDIT_LOG=executor_data/audit/executor.jsonl

# Agent reasoning mode.
# stub = deterministic local model for tests
# llm  = reserved for a real provider adapter
CFT_AGENT_MODE=stub
CFT_AGENT_MODEL_PROVIDER=
CFT_AGENT_MODEL_NAME=
