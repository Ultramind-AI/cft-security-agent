# Never commit real API keys. Put them in your local .env only.
GROQ_API_KEY=
ZAI_API_KEY=
MISTRAL_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
NVIDIA_NIM_API_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Agent mode. Keep stub for deterministic tests; use llm for live demo.
CFT_AGENT_MODE=stub

# Optional comma-separated provider:model override. When empty, the built-in
# provider-diverse fallback chain is used.
CFT_LLM_ROUTES=
CFT_LLM_TIMEOUT_SECONDS=25
CFT_LLM_MAX_OUTPUT_TOKENS=1200
CFT_LLM_TRACE=false

# Service API (T23)
# CFT_API_TARGET_PROFILES=targets/sberlab.yaml,targets/autodealer.yaml
# CFT_API_DATABASE_PATH=api_data/cft-security.sqlite3
# CFT_API_ARTIFACT_ROOT=artifacts/api-runs
# CFT_API_HOST=127.0.0.1
# CFT_API_PORT=8080
